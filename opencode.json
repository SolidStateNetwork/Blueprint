{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".ai/*.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "taskmaster-ai": {
      "type": "local",
      "command": ["npx", "-y", "task-master-ai"],
      "enabled": true
    }
  }
}
